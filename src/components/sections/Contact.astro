---
---

<section id="contact" class="section-padding relative">
  <div class="gradient-orb gradient-orb-gold w-[400px] h-[400px] -left-40 bottom-20 absolute"></div>

  <div class="section-container relative z-10">
    <span class="section-label" data-animate>Contact</span>
    <h2 class="section-title max-w-xl" data-animate>Let's Work Together</h2>
    <p class="text-text-secondary text-lg max-w-xl mb-12" data-animate>
      Open for freelance projects, full-time roles, and creative collaborations.
    </p>

    <div class="grid md:grid-cols-3 gap-6 max-w-3xl" data-animate>
      <!-- Email -->
      <a
        href="mailto:pcr.heilig@gmail.com"
        class="flex flex-col gap-3 p-6 bg-bg-card rounded-xl border border-white/5
               hover:border-accent-gold/30 transition-all duration-300 group card-hover"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-gold">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span class="text-text-secondary text-xs uppercase tracking-wider">Email</span>
        <span class="text-text-primary font-medium group-hover:text-accent-gold transition-colors duration-300">
          pcr.heilig@gmail.com
        </span>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/pascal-heilig-5954a733/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col gap-3 p-6 bg-bg-card rounded-xl border border-white/5
               hover:border-accent-gold/30 transition-all duration-300 group card-hover"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-gold">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
        <span class="text-text-secondary text-xs uppercase tracking-wider">LinkedIn</span>
        <span class="text-text-primary font-medium group-hover:text-accent-gold transition-colors duration-300">
          Pascal Heilig
        </span>
      </a>

      <!-- Location -->
      <div
        class="flex flex-col gap-3 p-6 bg-bg-card rounded-xl border border-white/5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-gold">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span class="text-text-secondary text-xs uppercase tracking-wider">Location</span>
        <span class="text-text-primary font-medium">Munich, Germany</span>
      </div>
    </div>
  </div>
</section>
