---
const vimeoId = '1168782812';
---

<section id="showreel" class="section-padding relative">
  <div class="section-container">
    <span class="section-label" data-animate>Showreel</span>
    <h2 class="section-title" data-animate>AI Showreel 2026</h2>
    <p class="text-text-secondary max-w-2xl mb-12 text-lg" data-animate>
      AI-powered visual effects &amp; creative technology — a look into recent projects and workflows.
    </p>

    <!-- Video Embed with 2-Click Solution -->
    <div class="relative w-full max-w-5xl mx-auto" data-animate>
      <div class="aspect-video rounded-xl overflow-hidden bg-bg-card border border-white/5">
        <!-- Consent Placeholder -->
        <div
          id="showreel-consent"
          class="relative w-full h-full flex flex-col items-center justify-center cursor-pointer group"
        >
          <!-- Placeholder gradient background -->
          <div class="absolute inset-0 bg-gradient-to-br from-bg-card via-bg-secondary to-bg-primary"></div>

          <div class="relative z-10 flex flex-col items-center gap-4 p-8 text-center">
            <!-- Play button icon -->
            <div class="w-20 h-20 rounded-full border-2 border-accent-gold/60 flex items-center justify-center
                        group-hover:border-accent-gold group-hover:bg-accent-gold/10 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="text-accent-gold ml-1">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>

            <p class="text-text-secondary text-sm max-w-sm">
              Click to load the video. Vimeo's privacy policy applies.
            </p>

            <button
              id="showreel-load-btn"
              class="btn-primary text-sm"
            >
              Load Video
            </button>
          </div>
        </div>

        <!-- Iframe (hidden until consent) -->
        <iframe
          id="showreel-iframe"
          class="w-full h-full hidden"
          title="AI Showreel 2026 — Pascal Heilig"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ vimeoId }}>
  const consentEl = document.getElementById('showreel-consent');
  const iframe = document.getElementById('showreel-iframe');
  const loadBtn = document.getElementById('showreel-load-btn');

  function loadVideo() {
    if (iframe && consentEl) {
      iframe.src = `https://player.vimeo.com/video/${vimeoId}?dnt=1&title=0&byline=0&portrait=0&autoplay=1`;
      iframe.classList.remove('hidden');
      consentEl.classList.add('hidden');
      // Save consent
      localStorage.setItem('lucidworks-video-consent', 'true');
    }
  }

  // Load directly if consent was previously given
  if (localStorage.getItem('lucidworks-video-consent') === 'true') {
    loadVideo();
  }

  loadBtn?.addEventListener('click', loadVideo);
  consentEl?.addEventListener('click', (e) => {
    if (e.target !== loadBtn) loadVideo();
  });
</script>
